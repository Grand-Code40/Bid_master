DRY_RUN=true
EMERGENCY_STOP=false

AUTO_BID_SCORE=88
REVIEW_SCORE=75
MIN_ACCEPTABLE_BID=25
MAX_AUTO_BID=500
MAX_DELIVERY_DAYS=7
PRICING_RULES_JSON=
MAX_BIDS_PER_RUN=1
MAX_BIDS_PER_DAY=2
MAX_BIDS_PER_MONTH=20
MAX_BIDS_PER_ACCOUNT_PER_DAY=1
MAX_SEQUENTIAL_BID_FAILURES=3
MAX_RATE_LIMIT_ERRORS=2

FREELANCER_SEARCH_QUERY=DXF CAD laser CNC PDF drawing
FREELANCER_SEARCH_LIMIT=50
FREELANCER_URL=
FREELANCER_ACCOUNTS_JSON=[]
FREELANCER_ACCOUNT_01_TOKEN=
FREELANCER_ACCOUNT_02_TOKEN=
FREELANCER_ACCOUNT_03_TOKEN=

# OpenAI-compatible provider (all three or none)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUIRED=false
